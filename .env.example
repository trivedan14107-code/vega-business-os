# Copy this file to .env.local and add your Groq key when API work begins.
GROQ_API_KEY=
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_REASONING_MODEL=openai/gpt-oss-120b
APP_ENV=development
DATABASE_URL=sqlite:///businessflow.db
APP_BASE_URL=http://localhost:8000

# Platform-owned OAuth configuration. Business owners never enter these values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=
DEFAULT_COMPANY_ID=demo-company
OWNER_EMAIL=owner@your-company.com
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
BUSINESS_TIMEZONE=Asia/Kolkata
DEFAULT_MEETING_DURATION_MINUTES=45
WHATSAPP_VERIFY_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://YOUR-PUBLIC-DOMAIN/api/oauth/slack/callback
SLACK_DEFAULT_CHANNEL_ID=
